    "fonts": {
      "headings": "'Playfair Display', serif",
      "accent": "'Cormorant Garamond', serif",
      "body": "'Jost', sans-serif"
    },
    "guidelines": "Load from Google Fonts. Headings must use Playfair Display. Accent words at the end of section headings must use Cormorant Garamond, italic, in primary gold (#C9A227). Overlines must be text-xs, uppercase, tracking-[0.35em], gold."
  },
  "layout_and_spacing": {
    "section_padding": "py-24 lg:py-32",
    "border_radius": "2px (rounded-sm) everywhere. No pills except for icon circles.",
    "dividers": "Gold hairline dividers (1px solid #C9A227 with low opacity)."
  },
  "components": {
    "buttons": {
      "primary": "Solid gold (#C9A227) with dark text, uppercase, letter-spacing 0.2em, 2px radius, hover bright gold (#E6C65C).",
