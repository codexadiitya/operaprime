    },
    "floating_action_buttons": "Sticky WhatsApp (green #3FBF6F) + Call (gold #C9A227) circular buttons at bottom-right.",
    "section_headings": "Mix Playfair with one Cormorant italic gold word at the end."
  },
  "sections_order": [
    "Header",
    "Hero (full-height dark image)",
    "Trust Strip",
    "Services (3 cols by category, dotted price leaders)",
    "Offers (3 cards, WhatsApp claim)",
    "Team (4 cards portrait)",
    "Gallery (6 asymmetric masonry, items 0/4 span 2x2)",
    "Testimonials (carousel)",
    "Booking Form (2-col layout with date/time/service dropdowns)",
    "FAQ (accordion)",
    "Location (2-col with grayscale map)",
    "Footer (4-col)"
