  "admin_panel": {
    "route": "/admin",
    "features": ["Login", "Dashboard tabs for Bookings, Services, Offers CRUD"]
  },
  "copy_tone": "Warm, confident, plain. Buttons should say outcome.",
  "instructions_to_main_agent": [
    "No light mode toggle. The site is entirely dark theme.",
    "Use exact hex colors provided in tailwind config.",
    "All interactive elements must include 'data-testid' attribute.",
    "Implement Shadcn UI but heavily customize it to match the provided styles, particularly rounded-sm and colors.",
    "Ensure the hero section overlay is subtle, and the CTA is prominent.",
    "Services list should use dotted borders for price leaders to look like a high-end menu.",
    "Gallery must be a 6-item asymmetric masonry grid, where items 0 and 4 span 2x2.",
    "Booking form needs exact dropdowns: date, time, and service.",
    "Location section must embed a grayscale Google map."
  ],
  "universal_guidelines_for_main_agent": [
    "You tend to converge toward generic outputs. Make creative, distinctive frontends that surprise and delight.",
    "Do not use dark colors as gradients.",
    "Create depth through layered design elements with z-index hierarchy.",
    "Do not center align the app container. Left-align text naturally.",
    "Use modern interactive button styles with hover animations.",
    "Avoid emoji characters for icons. Use lucide-react or other professional icon libraries.",
    "Apply generous spacing. The section padding is py-24 lg:py-32.",
    "Use sonner for toast notifications."
  ]
}